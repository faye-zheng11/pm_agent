{
  "schema_version": "2.0",
  "id": "pm-idea-to-delivery",
  "name": "PM 从想法到交付",
  "purpose": "只使用四个核心 Agent，把机会、产品方案、用户体验、独立评审、PRD、设计和概念 Demo 串成两次由 PM 决策的可追溯流程。",
  "entry_node": "context_preflight",
  "nodes": [
    {"id":"context_preflight","kind":"preflight","required_files":["HOME.md","PROJECT-CONTEXT.md","project.yaml","agent-config.json"]},
    {"id":"opportunity","kind":"agent","agent":"opportunity_researcher","task_type":"opportunity.scan","instruction":"围绕目标用户与本次决定完成多轮公开研究、原文回读、来源交叉和信号台账，最多输出五条可靠机会。","authority_level":"draft_write"},
    {"id":"shaping","kind":"agent","agent":"product_shaper","task_type":"product.shape","instruction":"把机会塑造成完整产品方案，并使用 pmf-bet-brief 形成可证伪 Bet；不得提前冒充正式 PRD。","authority_level":"draft_write"},
    {"id":"experience","kind":"agent","agent":"user_experience_reviewer","task_type":"ux.product","instruction":"用适合当前项目的模拟用户组完成六段旅程走查，分开真人证据与模拟假设。","authority_level":"draft_write"},
    {"id":"decision_review","kind":"agent","agent":"independent_critic","task_type":"review.decision","instruction":"独立审查机会、产品方案、Bet 和体验风险，输出与 Findings 一致的 Pass、Conditional 或 Block。","authority_level":"draft_write"},
    {"id":"pm_product_decision","kind":"human_approval","approval_type":"product_decision"},
    {"id":"prd","kind":"agent","agent":"product_shaper","task_type":"product.prd","instruction":"PM 产品门禁已通过。使用 prd-writing 生成中文正式 PRD；保持已确认范围，未确认内容继续标待决策。","authority_level":"draft_write"},
    {"id":"design","kind":"agent","agent":"product_shaper","task_type":"product.design","instruction":"基于已确认 PRD 生成设计规范、信息架构、页面与状态任务；Figma 不可用时交付可执行设计任务，不伪造写入。","authority_level":"draft_write"},
    {"id":"concept_demo","kind":"agent","agent":"product_shaper","task_type":"prototype.concept","instruction":"复用已确认方案与设计任务生成无真实数据库、可交互的 HTML 概念 Demo，并明确标记非生产实现。","authority_level":"draft_write"},
    {"id":"final_ux","kind":"agent","agent":"user_experience_reviewer","task_type":"ux.demo","instruction":"实际打开并点击概念 Demo，在桌面和手机视口走查核心、失败、恢复和退出路径；工具不可用时明确降级。","authority_level":"draft_write"},
    {"id":"delivery_review","kind":"agent","agent":"independent_critic","task_type":"review.delivery","instruction":"对照 Bet、PRD、设计任务、Demo 和 UX Findings 做最终交付评审，核查一致性、可执行性与剩余风险。","authority_level":"draft_write"},
    {"id":"pm_delivery_decision","kind":"human_approval","approval_type":"delivery_confirmation"},
    {"id":"done","kind":"terminal","terminal_status":"completed"},
    {"id":"blocked","kind":"terminal","terminal_status":"blocked"}
  ],
  "edges": [
    {"from":"context_preflight","to":"opportunity","trigger":"task_completed","condition":"context_ready"},
    {"from":"context_preflight","to":"blocked","trigger":"task_blocked","condition":"context_missing"},
    {"from":"opportunity","to":"shaping","trigger":"task_completed","condition":"completed"},
    {"from":"opportunity","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"shaping","to":"experience","trigger":"task_completed","condition":"completed"},
    {"from":"shaping","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"experience","to":"decision_review","trigger":"task_completed","condition":"completed"},
    {"from":"experience","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"decision_review","to":"pm_product_decision","trigger":"task_completed","condition":"critic_pass_or_conditional"},
    {"from":"decision_review","to":"blocked","trigger":"task_completed","condition":"critic_block"},
    {"from":"decision_review","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"pm_product_decision","to":"prd","trigger":"approval_decided","condition":"approved"},
    {"from":"pm_product_decision","to":"blocked","trigger":"approval_decided","condition":"rejected"},
    {"from":"prd","to":"design","trigger":"task_completed","condition":"completed"},
    {"from":"prd","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"design","to":"concept_demo","trigger":"task_completed","condition":"completed"},
    {"from":"design","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"concept_demo","to":"final_ux","trigger":"task_completed","condition":"completed"},
    {"from":"concept_demo","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"final_ux","to":"delivery_review","trigger":"task_completed","condition":"completed"},
    {"from":"final_ux","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"delivery_review","to":"pm_delivery_decision","trigger":"task_completed","condition":"critic_pass_or_conditional"},
    {"from":"delivery_review","to":"blocked","trigger":"task_completed","condition":"critic_block"},
    {"from":"delivery_review","to":"blocked","trigger":"task_blocked","condition":"blocked"},
    {"from":"pm_delivery_decision","to":"done","trigger":"approval_decided","condition":"approved"},
    {"from":"pm_delivery_decision","to":"blocked","trigger":"approval_decided","condition":"rejected"}
  ]
}
