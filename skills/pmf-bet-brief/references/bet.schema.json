{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMF Bet Brief",
  "type": "object",
  "required": ["bet_status", "pmf_stage", "primary_unknown", "expected_learning", "hypothesis", "target_user", "uncertainties", "experiment", "signals", "decision_rules", "kill_conditions", "next_review"],
  "properties": {
    "bet_status": {"enum": ["draft", "ready", "running", "concluded"]},
    "pmf_stage": {"enum": ["problem_signal", "solution_validation", "repeat_value", "business_model", "growth_readiness"]},
    "primary_unknown": {"enum": ["problem", "target_user", "solution", "repeat_value", "business_model", "growth"]},
    "expected_learning": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 30},
    "target_user": {"type": "object"},
    "context": {"type": "string"},
    "job": {"type": "string"},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "experiment": {"type": "object"},
    "signals": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "decision_rules": {"type": "object", "required": ["continue", "narrow", "pivot", "stop"]},
    "kill_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "guardrails": {"type": "array", "items": {"type": "string"}},
    "next_review": {"type": "string"},
    "owner": {"type": "string"}
  },
  "additionalProperties": true
}
