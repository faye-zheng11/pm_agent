{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Tool Registry",
  "type": "object",
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"type": "string"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "risk", "approval", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string"},
          "risk": {"enum": ["read_only", "draft_write", "reversible_action", "external_action", "destructive_action"]},
          "approval": {"enum": ["never", "policy", "always"]},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
