{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic User Experience Review",
  "type": "object",
  "required": ["review_mode", "synthetic_boundary", "personas", "journey", "experience_dimensions", "findings", "real_evidence_refs", "simulated_assumptions", "research_questions", "prioritized_changes", "unverified_visuals", "handoff_summary", "frameworks_used"],
  "properties": {
    "review_mode": {"enum": ["idea", "product_plan", "prd", "screenshot", "figma", "html_demo"]},
    "synthetic_boundary": {"type": "string", "minLength": 20},
    "personas": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "required": ["segment", "context", "needs", "constraints"], "properties": {"segment": {"type": "string"}, "context": {"type": "string"}, "needs": {"type": "array", "items": {"type": "string"}}, "constraints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "journey": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["stage", "user_goal", "predicted_reaction", "friction", "evidence_basis"], "properties": {"stage": {"enum": ["enter", "understand", "try", "feedback", "return", "exit"]}, "user_goal": {"type": "string"}, "predicted_reaction": {"type": "string"}, "friction": {"type": "string"}, "evidence_basis": {"enum": ["real_evidence", "project_fact", "expert_inference", "synthetic_assumption"]}}, "additionalProperties": false}},
    "experience_dimensions": {"type": "object", "required": ["comprehension", "motivation", "emotion", "trust", "cultural_fidelity", "accessibility", "safety"], "properties": {"comprehension": {"enum": ["good", "risk", "unknown"]}, "motivation": {"enum": ["good", "risk", "unknown"]}, "emotion": {"enum": ["good", "risk", "unknown"]}, "trust": {"enum": ["good", "risk", "unknown"]}, "cultural_fidelity": {"enum": ["good", "risk", "unknown"]}, "accessibility": {"enum": ["good", "risk", "unknown"]}, "safety": {"enum": ["good", "risk", "unknown"]}}, "additionalProperties": false},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "category", "issue", "affected_users", "impact", "recommendation", "validation_question", "evidence_refs"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["blocker", "major", "minor"]}, "category": {"enum": ["comprehension", "motivation", "emotion", "trust", "culture", "accessibility", "safety", "flow", "visual"]}, "issue": {"type": "string"}, "affected_users": {"type": "array", "items": {"type": "string"}}, "impact": {"type": "string"}, "recommendation": {"type": "string"}, "validation_question": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "real_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "simulated_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "research_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prioritized_changes": {"type": "array", "items": {"type": "object", "required": ["priority", "change", "reason"], "properties": {"priority": {"enum": ["now", "next", "later"]}, "change": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "unverified_visuals": {"type": "array", "items": {"type": "string"}},
    "handoff_summary": {"type": "string", "minLength": 1},
    "iteration_comparison": {"type": "object", "required": ["what_changed", "what_is_fixed", "regressions", "post_release_signal", "rollback_trigger"], "properties": {"what_changed": {"type": "string"}, "what_is_fixed": {"type": "string"}, "regressions": {"type": "array", "items": {"type": "string"}}, "post_release_signal": {"type": "string"}, "rollback_trigger": {"type": "string"}}, "additionalProperties": false},
    "frameworks_used": {"type": "array", "maxItems": 2, "items": {"type": "object", "required": ["id", "purpose", "input_basis", "output_used", "evidence_boundary"], "properties": {"id": {"enum": ["jtbd", "pain-solution-matrix", "user-journey-map", "mental-models", "elevator-pitch", "wardley-mapping"]}, "purpose": {"type": "string", "minLength": 1}, "input_basis": {"type": "string", "minLength": 1}, "output_used": {"type": "string", "minLength": 1}, "evidence_boundary": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "ui_quality_summary": {"type": "object", "required": ["task_clarity", "context_visibility", "progressive_disclosure", "responsive_accessibility", "visual_specificity"], "properties": {"task_clarity": {"enum": ["good", "risk", "unknown"]}, "context_visibility": {"enum": ["good", "risk", "unknown"]}, "progressive_disclosure": {"enum": ["good", "risk", "unknown"]}, "responsive_accessibility": {"enum": ["good", "risk", "unknown"]}, "visual_specificity": {"enum": ["good", "risk", "unknown"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
