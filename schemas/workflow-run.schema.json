{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Workflow Run",
  "type": "object",
  "required": ["schema_version", "id", "project_id", "workflow_id", "goal", "decision_to_support", "status", "nodes", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^workflow-[a-z0-9-]+$"},
    "project_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "goal": {"type": "string"},
    "decision_to_support": {"type": "string"},
    "status": {"enum": ["queued", "running", "waiting_input", "waiting_approval", "blocked", "interrupted", "completed", "failed", "cancelled"]},
    "nodes": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
