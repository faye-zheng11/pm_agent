{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Agent Input Request",
  "type": "object",
  "required": ["schema_version", "id", "task_id", "status", "questions", "reason", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^input-[a-z0-9-]+$"},
    "task_id": {"type": "string"},
    "status": {"enum": ["pending", "provided", "cancelled"]},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "response_type", "required", "sensitive"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "response_type": {"enum": ["text", "url", "boolean", "choice"]},
          "required": {"type": "boolean"},
          "sensitive": {"type": "boolean"},
          "options": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "reason": {"type": "string"},
    "responses": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
