  "properties": {
    "to_agent": {"type": "string"},
    "task_type": {"type": "string"},
    "goal": {"type": "string"},
    "source_artifacts": {"type": "array", "items": {"type": "string"}},
    "blocking": {"type": "boolean"},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
