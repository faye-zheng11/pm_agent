{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable PM Agent Package",
  "type": "object",
  "required": ["schema_version", "id", "runtime_agent_id", "name", "version", "mission", "modes", "inputs", "outputs", "skills", "knowledge_assets", "tools", "output_schema", "ui", "eval_case_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "runtime_agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mission": {"type": "string", "minLength": 1},
    "modes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "project_required"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "project_required": {"type": "boolean"}}, "additionalProperties": false}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "type", "required"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "type": {"enum": ["text", "textarea", "select", "date_range", "files", "urls", "boolean"]}, "required": {"type": "boolean"}, "options": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "knowledge_assets": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "output_schema": {"type": "string"},
    "ui": {"type": "object", "required": ["accent", "start_label", "result_sections"], "properties": {"accent": {"type": "string"}, "start_label": {"type": "string"}, "result_sections": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "eval_case_ids": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
