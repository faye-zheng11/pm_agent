{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Agent Registry",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {"type": "string"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "mission", "lifecycle_status", "accepted_task_types", "required_context", "skills", "allowed_tools", "output_schema", "authority", "reviewer", "stop_conditions", "retry_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string", "minLength": 1},
          "mission": {"type": "string", "minLength": 1},
          "lifecycle_status": {"enum": ["core", "optional", "experimental", "retired"]},
          "accepted_task_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_context": {"type": "array", "items": {"type": "string"}},
          "skills": {"type": "array", "items": {"type": "string"}},
          "knowledge_assets": {"type": "array", "items": {"type": "string"}},
          "allowed_tools": {"type": "array", "items": {"type": "string"}},
          "output_schema": {"type": "string"},
          "authority": {
            "type": "object",
            "required": ["can", "cannot"],
            "properties": {
              "can": {"type": "array", "items": {"type": "string"}},
              "cannot": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "reviewer": {"type": "string"},
          "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "retry_policy": {
            "type": "object",
            "required": ["max_attempts", "backoff_seconds"],
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
              "backoff_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
