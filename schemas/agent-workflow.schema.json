{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Agent Workflow",
  "type": "object",
  "required": ["schema_version", "id", "name", "purpose", "entry_node", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "name": {"type": "string"},
    "purpose": {"type": "string"},
    "entry_node": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["agent", "human_approval", "join", "terminal"]},
          "agent": {"type": "string"},
          "task_type": {"type": "string"},
          "instruction": {"type": "string"},
          "authority_level": {"enum": ["read_only", "draft_write", "reversible_action", "external_action"]},
          "wait_for": {"type": "array", "items": {"type": "string"}},
          "approval_type": {"type": "string"},
          "terminal_status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger", "condition"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "trigger": {"enum": ["task_completed", "task_blocked", "join_ready", "approval_decided"]},
          "condition": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
