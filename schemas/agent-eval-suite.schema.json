{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM Workbench Agent Eval Suite",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent_id", "task_type", "scenario", "expected_behaviors", "forbidden_behaviors", "required_trace_events"],
        "properties": {
          "id": {"type": "string"},
          "agent_id": {"type": "string"},
          "task_type": {"type": "string"},
          "scenario": {"type": "string"},
          "expected_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_trace_events": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
